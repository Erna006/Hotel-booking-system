# For host development. Compose uses db:5432 inside the Docker network.
POSTGRES_URL=postgresql+asyncpg://hotel:hotel@127.0.0.1:15432/hotel
# Generate a private value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=hotel-booking
JWT_AUDIENCE=hotel-api
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Optional published Compose ports (change when a port is already occupied).
BACKEND_PORT=8000
FRONTEND_PORT=5173
